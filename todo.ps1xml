<?xml version="1.0" encoding="utf-8" ?>
<Configuration> 
	<ViewDefinitions>
		<View>
			<Name>TaskList-Custom</Name>
			<ViewSelectedBy>
				<TypeName>todotxtlib.net.NumberedTask</TypeName>
			</ViewSelectedBy>
			<CustomControl>
				<CustomEntries>
					<CustomEntry>
						<CustomItem>
							<ExpressionBinding>
								<ScriptBlock>'{0,3}' -f $_.Number</ScriptBlock>
							</ExpressionBinding>
							<Text> </Text>
							<ExpressionBinding>
								<ScriptBlock>
									$raw = $_.Task.ToString()
									$w = $raw.Length;
									$e = "";
									if($w -gt ([console]::BufferWidth - 9)){$e = "..."; $w = ([console]::BufferWidth - 9);}
									$raw.Substring(0, $w) + $e;
								</ScriptBlock>
							</ExpressionBinding>
						</CustomItem>
					</CustomEntry>
				</CustomEntries>
			</CustomControl>
		</View>
	</ViewDefinitions>
</Configuration>
